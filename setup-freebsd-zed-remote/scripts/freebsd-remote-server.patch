@@ -0,0 +1,111 @@
+//! FreeBSD stand-in for the real crash handler in crashes_full.
+//!
+//! crash-handler and minidumper only build on Windows, macOS and Linux, so on
+//! FreeBSD the crate is compiled from this module instead (see lib.rs). Every
+//! entry point is a no-op that keeps the crate's public API identical: the
+//! remote server still runs, it just never writes minidumps. Crashes on FreeBSD
+//! surface through the normal log stream.
+
+use std::collections::BTreeMap;
+use std::future::Future;
+use std::panic::Location;
+use std::path::{Path, PathBuf};
+use std::pin::Pin;
+use std::sync::Arc;
+use std::time::Duration;
+
+use serde::{Deserialize, Serialize};
+use system_specs::{GpuInfo, GpuSpecs};
+
+/// Stand-in for minidumper::Client. There is no sidecar to talk to, so this
+/// handle is only ever created and dropped; callers never inspect it.
+#[derive(Debug, Clone)]
+pub struct Client;
+
+#[derive(Debug, Deserialize, Serialize, Clone)]
+pub struct InitCrashHandler {
+    pub session_id: String,
+    pub zed_version: String,
+    pub binary: String,
+    pub release_channel: String,
+    pub commit_sha: String,
+}
+
+#[derive(Deserialize, Serialize, Debug, Clone)]
+pub struct CrashPanic {
+    pub message: String,
+    pub span: String,
+}
+
+#[derive(Debug, Deserialize, Serialize, Clone)]
+pub struct AbortMessageLocation {
+    pub pid: u32,
+    pub address: u64,
+}
+
+#[derive(Debug, Deserialize, Serialize, Clone)]
+pub struct CrashInfo {
+    pub init: InitCrashHandler,
+    pub panic: Option<CrashPanic>,
+    pub minidump_error: Option<String>,
+    #[serde(default)]
+    pub abort_message: Option<String>,
+    pub gpus: Vec<GpuInfo>,
+    pub active_gpu: Option<GpuSpecs>,
+    #[serde(default)]
+    pub tags: BTreeMap<String, String>,
+}
+
+#[derive(Debug, Clone)]
+pub struct UserInfo {
+    pub metrics_id: Option<String>,
+    pub is_staff: Option<bool>,
+}
+
+/// The Sentry field identifying the crashing user, mirroring crashes_full.
+pub const SENTRY_USER_ID: &str = "sentry[user][id]";
+
+/// No panic hook is installed; the default hook still prints the backtrace.
+pub fn force_backtrace() {}
+
+/// Resolves to a placeholder handle without installing any signal handlers.
+pub fn init<F, S, C, P>(
+    _crash_init: InitCrashHandler,
+    _spawn: S,
+    _socket_path: P,
+    _wait_timer: C,
+) -> impl Future<Output = Arc<Client>> + use<F, C, S, P>
+where
+    F: Future<Output = ()> + Send + Sync + 'static,
+    C: (Fn(Duration) -> F) + Send + Sync + 'static,
+    S: FnOnce(Pin<Box<dyn Future<Output = ()> + Send + 'static>>),
+    P: FnOnce(u32) -> PathBuf,
+{
+    log::info!("crash handler disabled on FreeBSD");
+    async { Arc::new(Client) }
+}
+
+/// The sidecar entry point is never spawned on FreeBSD.
+pub fn crash_server(_socket: &Path, _logs_dir: PathBuf) {
+    log::info!("crash server disabled on FreeBSD");
+}
+
+/// Session state is only recorded in the caller; there is no sidecar to forward
+/// it to, so these are intentionally no-ops.
+pub fn set_gpu_info(_crash_client: &Arc<Client>, _specs: GpuSpecs) {}
+
+pub fn set_user_info(_crash_client: &Arc<Client>, _info: UserInfo) {}
+
+pub fn set_tag(_crash_client: &Arc<Client>, _key: impl Into<String>, _value: Option<String>) {}
+
+pub fn set_tags<K>(
+    _crash_client: &Arc<Client>,
+    _tags: impl IntoIterator<Item = (K, Option<String>)>,
+) where
+    K: Into<String>,
+{
+}
+
+pub fn shutdown_crash_handler(_crash_client: &Arc<Client>) {}
+
+pub fn panic_hook(_crash_client: Arc<Client>, _message: &str, _location: Option<&Location>) {}
